{
  "name": "vitecache",
  "version": "0.5.0",
  "description": "Persistent binary caching for expensive computation, warmed in Node by a Vite plugin and read in browsers and Node.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/drawcall-ai/vitecache.git",
    "directory": "packages/vitecache"
  },
  "bugs": {
    "url": "https://github.com/drawcall-ai/vitecache/issues"
  },
  "homepage": "https://github.com/drawcall-ai/vitecache#readme",
  "keywords": [
    "vite",
    "cache",
    "precompute",
    "browser",
    "node",
    "typescript"
  ],
  "sideEffects": false,
  "main": "./dist/browser.js",
  "types": "./dist/browser.d.ts",
  "exports": {
    ".": {
      "types": "./dist/browser.d.ts",
      "browser": "./dist/browser.js",
      "node": "./dist/node.js",
      "default": "./dist/browser.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "default": "./dist/vite.js"
    }
  },
  "files": [
    "dist",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.json",
    "prepack": "pnpm build && pnpm typecheck && pnpm test",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit"
  },
  "dependencies": {
    "@noble/hashes": "^2.0.1",
    "json5": "2.2.3",
    "picocolors": "1.1.1",
    "picomatch": "4.0.3",
    "safe-stable-stringify": "2.5.0",
    "tinyglobby": "0.2.15",
    "write-file-atomic": "6.0.0"
  },
  "peerDependencies": {
    "vite": ">=8.0.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/picomatch": "4.0.2",
    "@types/write-file-atomic": "4.0.3",
    "vite": "^8.0.0",
    "vitest": "^4.0.17"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
