{
  "name": "vitecache-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.18.0",
  "scripts": {
    "build": "pnpm -r --if-present build",
    "check": "pnpm build && pnpm typecheck && pnpm test",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "dev": "pnpm --filter @drawcall/vitecache build && pnpm --filter @drawcall/vitecache-example-mandelbrot dev",
    "precompute": "pnpm --filter @drawcall/vitecache build && pnpm --filter @drawcall/vitecache-example-mandelbrot precompute"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "typescript": "^5.9.3"
  }
}
